{
    "name": "iamjuan/spamast-sso-client",
    "description": "SPAMAST SSO client for Laravel apps: sign in from the hub, pending accounts, and a hub API for the mobile app.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Spamast\\Sso\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Spamast\\Sso\\SsoServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
